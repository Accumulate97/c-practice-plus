{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem",
  "description": "C practice 题目统一数据结构 v3.3。基础字段共用，按 type 追加特有字段。支持 25 种题型。根节点 unevaluatedProperties:false 禁止规范外字段（如 score），新增字段必须先改本 Schema。",
  "type": "object",
  "required": ["id", "type", "category", "chapter", "section", "difficulty", "bloom", "stem", "explanation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[cd]s?-ch[0-9]{2}-(cc|dbg|cr|pg|sc|tf|fb|co|sa|cx|mt|pt|mb|ti|sr|ad|opt|rv|te|ea|alg|mdb|dsdbg|cxa|str)-[0-9]{3}$",
      "description": "全局唯一。格式：{c|ds}-章号-题型缩写-序号。题型缩写：cc程序填空 dbg改错 cr阅读 pg编程 sc选择 tf判断 fb概念填空 co代码排序 sa简答 cx复杂度 mt匹配 pt指针追踪 mb多空填空 ti限时实现 sr标准库重实现 adAPI练习 opt代码优化 rv代码评审 te术语解释 ea论述 alg算法实现 mdb多错改 dsdbg数据结构改错 cxa数值型复杂度分析 str结构构造追踪"
    },
    "type": {
      "type": "string",
      "enum": ["code_completion", "debug", "code_reading", "programming",
               "single_choice", "true_false", "fill_blank",
               "code_ordering", "short_answer", "complexity", "matching",
               "pointer_trace", "multi_blank", "timed_impl", "stdlib_reimpl",
               "api_drill", "code_optimization", "code_review",
               "term_explanation", "essay_answer",
               "algorithm_impl", "multi_bug_debug",
               "ds_debug", "complexity_analysis", "structure_trace"],
      "description": "主力题型为前四种；pointer_trace/timed_impl/stdlib_reimpl/api_drill/code_optimization/code_review/multi_blank 为扩张主力；algorithm_impl/multi_bug_debug 为任务04量产主力；term_explanation/essay_answer 为概念型；ds_debug/complexity_analysis/structure_trace 为 DS 板块扩充新增三型（数据结构改错 / 数值型复杂度与 ASL 分析 / 结构构造追踪）"
    },
    "category": {
      "type": "string",
      "enum": ["c", "ds"],
      "description": "c = C语言, ds = 数据结构"
    },
    "chapter": { "type": "string", "description": "如 第9章 指针" },
    "section": { "type": "string", "description": "如 9.3 指针与数组" },
    "source": {
      "type": "string",
      "description": "出处。教材原题写 书名+题号；变式写 变式（源自...）；原创写 原创（依据大纲考点：...）"
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "bloom": {
      "type": "string",
      "enum": ["remember", "understand", "apply", "analyze"]
    },
    "stem": { "type": "string", "description": "题干" },
    "explanation": {
      "type": "string",
      "description": "详解，必填。讲清为什么，不只是答案是什么"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "知识点标签"
    },
    "knowledgeIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "关联的知识卡片 id，用于跳转"
    },
    "vizIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "关联的可视化演示 id"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "代码类题目是否通过实机编译验证。非代码题固定 true"
    },
    "variantOf": {
      "type": "string",
      "default": "",
      "description": "母题 id；有母题的必须指向母题 id，无母题留空串"
    },
    "constraints": {
      "type": "string",
      "description": "规格约束（算法题与熟练度专项必填）：n 范围 / 时间复杂度 / 空间复杂度。例：&quot;1 ≤ n ≤ 10^5；时间复杂度 O(n)；空间复杂度 O(1)&quot;"
    },
    "ai_generated": { "type": "boolean", "default": true },
    "generated_at": { "type": "string", "format": "date" }
  },

  "unevaluatedProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "code_completion" } } },
      "then": {
        "required": ["code", "blanks", "solution", "testCases"],
        "properties": {
          "code": { "type": "string", "description": "含 /*__BLANK_n__*/ 标记的代码" },
          "blanks": {
            "type": "array", "minItems": 1, "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["index", "answer"],
              "properties": {
                "index": { "type": "integer", "minimum": 1 },
                "hint": { "type": "string" },
                "answer": { "type": "string" },
                "accepted": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "solution": { "type": "string", "description": "补全后的完整代码" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "debug" } } },
      "then": {
        "required": ["code", "bugs", "fixed_code", "testCases"],
        "properties": {
          "code": { "type": "string" },
          "bugs": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "string" },
            "description": "植入的错误说明，不展示给学生"
          },
          "fixed_code": { "type": "string" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "code_reading" } } },
      "then": {
        "required": ["code", "answer"],
        "properties": {
          "code": { "type": "string" },
          "stdin": {
            "type": "string",
            "default": "",
            "description": "程序运行时需要喂给 stdin 的输入（含换行）。缺失按空串处理。2026-09-09 加字段：读输入的阅读题此前一律喂空串，scanf 撞 EOF 得到垃圾输出，实机对照永远失败（docs/verify-report-2026-09-08.md C/D 类 39 题）。数据填充另行安排，本次只加结构与读取口径。"
          },
          "answer": { "type": "string", "description": "真实运行结果或功能描述" },
          "answerIsDescription": {
            "type": "boolean", "default": false,
            "description": "true 表示本题要求描述功能而非写出输出"
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "programming" } } },
      "then": {
        "required": ["reference", "testCases"],
        "properties": {
          "input_format": { "type": "string" },
          "output_format": { "type": "string" },
          "code_starter": { "type": "string" },
          "reference": { "type": "string" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "single_choice" } } },
      "then": {
        "required": ["options", "answer"],
        "properties": {
          "options": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "string" }
          },
          "answer": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "true_false" } } },
      "then": {
        "required": ["answer"],
        "properties": { "answer": { "type": "boolean" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "fill_blank" } } },
      "then": {
        "required": ["blanks"],
        "properties": {
          "blanks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["index", "answer"],
              "properties": {
                "index": { "type": "integer", "minimum": 1 },
                "answer": { "type": "string" },
                "accepted": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "code_ordering" } } },
      "then": {
        "required": ["lines", "correct_order", "testCases"],
        "properties": {
          "lines": { "type": "array", "items": { "type": "string" }, "description": "打乱后的代码行" },
          "correct_order": {
            "type": "array", "items": { "type": "integer" },
            "description": "正确顺序，元素为 lines 的下标"
          },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "short_answer" } } },
      "then": {
        "required": ["reference_answer", "grading_points"],
        "properties": {
          "reference_answer": { "type": "string" },
          "grading_points": {
            "type": "array", "items": { "type": "string" },
            "description": "评分要点，供学生自评"
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "complexity" } } },
      "then": {
        "required": ["code", "answer"],
        "properties": {
          "code": { "type": "string" },
          "answer": { "type": "string", "description": "如 O(n^2)" },
          "accepted": { "type": "array", "items": { "type": "string" } },
          "askSpace": { "type": "boolean", "default": false, "description": "true 表示问空间复杂度" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "matching" } } },
      "then": {
        "required": ["pairs"],
        "properties": {
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["left", "right"],
              "properties": {
                "left": { "type": "string" },
                "right": { "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "pointer_trace" } } },
      "then": {
        "required": ["code", "answer"],
        "properties": {
          "code": { "type": "string", "description": "含指针操作的代码，学生需追踪执行结果" },
          "stdin": {
            "type": "string",
            "default": "",
            "description": "程序运行时喂给 stdin 的输入（含换行）。缺失按空串处理"
          },
          "answer": { "type": "string", "description": "指针追踪后各输出/各指针取值" },
          "answerIsDescription": {
            "type": "boolean", "default": false,
            "description": "true 表示要求描述指针行为而非写出输出"
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "multi_blank" } } },
      "then": {
        "required": ["code", "blanks", "solution", "testCases"],
        "properties": {
          "code": { "type": "string", "description": "含 /*__BLANK_n__*/ 标记的代码（多处空）" },
          "blanks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["index", "answer"],
              "properties": {
                "index": { "type": "integer", "minimum": 1 },
                "hint": { "type": "string" },
                "answer": { "type": "string" },
                "accepted": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "solution": { "type": "string", "description": "补全后的完整代码" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "timed_impl" } } },
      "then": {
        "required": ["reference", "testCases", "constraints"],
        "properties": {
          "reference": { "type": "string", "description": "参考实现" },
          "timeLimitSec": { "type": "integer", "minimum": 1, "description": "限时（秒），面向熟练度展示用" },
          "code_starter": { "type": "string", "description": "给学生代码的起始模板" },
          "constraints": { "type": "string", "description": "规格约束（熟练度专项必填）：n 范围 / 时间复杂度 / 空间复杂度" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "stdlib_reimpl" } } },
      "then": {
        "required": ["reference", "testCases"],
        "properties": {
          "apiName": { "type": "string", "description": "重实现的标准库函数名，如 strcpy" },
          "reference": { "type": "string", "description": "参考实现（按原型实现该函数）" },
          "code_starter": { "type": "string", "description": "给学生代码的起始模板" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "api_drill" } } },
      "then": {
        "required": ["reference", "requiredApi", "testCases"],
        "properties": {
          "reference": { "type": "string", "description": "参考实现" },
          "requiredApi": {
            "type": "array", "minItems": 1, "items": { "type": "string" },
            "description": "学生代码必须调用的 API 清单，未调用即不通过"
          },
          "code_starter": { "type": "string", "description": "给学生代码的起始模板" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "code_optimization" } } },
      "then": {
        "required": ["code", "reference", "baselineComplexity", "targetComplexity", "testCases"],
        "properties": {
          "code": { "type": "string", "description": "能跑通但低效的代码，需改优并保持输出一致" },
          "reference": { "type": "string", "description": "优化后的参考实现" },
          "baselineComplexity": { "type": "string", "minLength": 1, "description": "原代码复杂度，如 O(n^2)。★ 这两个字段被列为 required：批量生成器曾因程序库字段名写成 baselineComplexity（生成器读的是 o.baseline）而静默丢字段，undefined 被 JSON.stringify 丢掉后 schema 又不检查，于是 ds-ch01-opt-001 带着缺失字段通过了全部七道闸门。" },
          "targetComplexity": { "type": "string", "minLength": 1, "description": "目标复杂度，如 O(n log n)" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "code_review" } } },
      "then": {
        "required": ["code", "reviewPoints"],
        "properties": {
          "code": { "type": "string", "description": "待评审的代码片段" },
          "reviewPoints": {
            "type": "array", "items": { "type": "string" },
            "description": "评审应指出的要点"
          },
          "reference_answer": { "type": "string", "description": "参考评审意见" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "term_explanation" } } },
      "then": {
        "required": ["keyPoints"],
        "properties": {
          "keyPoints": {
            "type": "array", "minItems": 1, "items": { "type": "string" },
            "description": "判定要点；命中数 ≥ 总数-1 即通过"
          },
          "reference_answer": { "type": "string", "description": "参考解释" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "essay_answer" } } },
      "then": {
        "required": ["reference_answer", "keyPoints"],
        "properties": {
          "reference_answer": { "type": "string", "description": "参考论述" },
          "keyPoints": {
            "type": "array", "items": { "type": "string" },
            "description": "评分要点，供学生自评"
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "algorithm_impl" } } },
      "then": {
        "required": ["reference", "testCases", "constraints"],
        "properties": {
          "input_format": { "type": "string" },
          "output_format": { "type": "string" },
          "code_starter": { "type": "string" },
          "reference": { "type": "string" },
          "constraints": { "type": "string", "description": "规格约束（算法题必填）：n 范围 / 时间复杂度 / 空间复杂度" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "multi_bug_debug" } } },
      "then": {
        "required": ["code", "bugs", "fixed_code", "testCases"],
        "properties": {
          "code": { "type": "string" },
          "bugs": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "string" },
            "description": "植入的错误说明，不展示给学生"
          },
          "fixed_code": { "type": "string" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "ds_debug" } } },
      "then": {
        "required": ["code", "bugs", "fixed_code", "testCases"],
        "properties": {
          "code": {
            "type": "string",
            "description": "含缺陷的数据结构程序。缺陷取自 DS 高频错误库：链表断链 / 指针丢失 / 遍历死循环 / 栈溢出 / 队列假溢出 / AVL 旋转漏情况 / 哈希冲突处理错误 / 越界访问 / 内存泄漏"
          },
          "bugs": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": { "type": "string" },
            "description": "植入的错误说明，不展示给学生（三级提示的第 3 级才展开原文）"
          },
          "defectKind": {
            "type": "string",
            "enum": ["链表断链", "指针丢失", "遍历死循环", "栈溢出", "队列假溢出",
                     "AVL旋转漏情况", "哈希冲突处理错误", "越界访问", "内存泄漏",
                     "重复释放", "空指针解引用", "循环边界错误", "条件判断错误",
                     "赋值顺序错误", "初始化错误", "算法分析", "其他"],
            "description": "缺陷类别，用于筛选与统计；缺省按「其他」处理。★ 前七项是任务书给的 DS 专属清单，后面几项是通用 C 缺陷。这份词表是「可筛选的分类」不是「穷举」：新增缺陷类型就加一项，不要为了省事一律填「其他」——那样这个字段就白设了。"
          },
          "fixed_code": { "type": "string", "description": "修正后的完整程序，judge:verify 实机编译执行的就是这一份" },
          "testCases": { "$ref": "#/definitions/testCases" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "complexity_analysis" } } },
      "then": {
        "required": ["asks"],
        "properties": {
          "code": { "type": "string", "description": "可选：待分析的程序或算法片段" },
          "asks": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": { "$ref": "#/definitions/gradedAsk" },
            "description": "逐问的数值答案：ASL成功 / ASL失败 / 比较次数 / 移动次数 / 交换次数 / 递归深度 / 队列峰值 / WPL 等。全部数值精确比对（tolerance 缺省 0）"
          },
          "complexity": {
            "type": "string",
            "description": "可选：渐近结论，如 O(n log n)。非空时也要作答，按复杂度归一化比对"
          },
          "accepted": { "type": "array", "items": { "type": "string" }, "description": "complexity 的可接受写法" },
          "askSpace": { "type": "boolean", "default": false, "description": "true 表示 complexity 问的是空间复杂度" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "structure_trace" } } },
      "then": {
        "required": ["sequence", "structureKind"],
        "properties": {
          "sequence": { "type": "string", "description": "给定的输入序列或边集，如 49 38 65 97 76 13 27" },
          "structureKind": {
            "type": "string",
            "enum": ["bst", "avl", "huffman", "heap", "mst", "shortest_path", "topo", "critical_path",
                     "hash_table", "btree", "forest", "general_list", "other"],
            "description": "要构造的结构类别"
          },
          "nodeSpec": {
            "type": "string",
            "description": "期望的最终结构。括号表示法如 45(24(12,37),53(-,93))，堆用数组形式如 97 76 65 49 49 13 27。空串表示不问结构本身"
          },
          "traversalOrder": {
            "type": "array", "items": { "$ref": "#/definitions/gradedAsk" },
            "description": "期望的遍历序列，每条独立判分。label 用「先序」「中序」「后序」「层序」这类固定字样"
          },
          "constructionResult": {
            "type": "string",
            "description": "期望的构造结果：MST 边集与总权值 / 哈夫曼编码表 / WPL / 拓扑序列 / 关键路径 等。空串表示不问"
          },
          "traceSteps": {
            "type": "array", "items": { "type": "string" },
            "description": "构造过程的分步快照（每插入一个元素后的形态、每趟调整后的数组）。只在参考答案面板展示，不参与判分"
          },
          "code": { "type": "string", "description": "可选：构造过程的可运行程序，供学生对照" }
        }
